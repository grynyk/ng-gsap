{
  "name": "ng-gsap-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve playground",
    "build:lib": "ng build ng-gsap && yarn build:schematics",
    "build:schematics": "node scripts/build-schematics.mjs",
    "build:playground": "ng build playground --base-href /ng-gsap/",
    "watch": "ng build ng-gsap --watch --configuration development",
    "test": "ng test ng-gsap",
    "test:coverage": "ng test ng-gsap --coverage",
    "test:browser": "ng test ng-gsap --browsers chromium --headless",
    "test:playground": "ng test playground",
    "e2e": "node e2e/smoke.mjs",
    "verify:ssr": "node e2e/ssr-check.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "format": "prettier --write \"{projects,e2e,scripts}/**/*.{ts,html,scss,mjs}\"",
    "format:check": "prettier --check \"{projects,e2e,scripts}/**/*.{ts,html,scss,mjs}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.6",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^22.1.6",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@schematics/angular": "^22.1.6",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11"
  }
}
